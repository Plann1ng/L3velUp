# Supabase — client-side (NEXT_PUBLIC_ prefix makes these available in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — server-side only (NEVER prefix with NEXT_PUBLIC_)
# Used only in Server Components and Route Handlers via createAdminSupabaseClient()
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
